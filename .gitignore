# Unreal Engine folders
Binaries/
DerivedDataCache/
Intermediate/
Saved/

# Compiled binaries
*.pdb
*.obj
*.exe
*.dll
*.app
*.dylib
*.lib
*.so

# Project files
.vscode/
.vs/
*.sln
*.VC.db
*.opensdf

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Unreal auto-generated folders/files
Build/

# Ignore autosaves and backup folders
Autosaves/
Backup/

# Log files
*.log

# Optional - Git LFS tracked files
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
